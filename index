body {
    background-color: #fff5f5;
    font-family: Arial, sans-serif;
    color: #4a0000;
    margin: 20px;
}

h1 {
    text-align: center;
    color: #8b0000;
}

h2 {
    color: #a30000;
}

hr {
    border: 1px solid #cc0000;
    margin: 20px 0;
}

ul {
    line-height: 1.6;
}

table {
    border-collapse: collapse;
    width: 100%;
}

table, th, td {
    border: 1px solid #cc3333;
}

th, td {
    padding: 6px;
    text-align: left;
}

th {
    background-color: #8b0000;
    color: white;
}

tr:nth-child(even) {
    background-color: #ffe6e6;
}

tr:hover {
    background-color: #ffcccc;
}

img {
    border-radius: 10px;
    border: 3px solid #cc0000;
}

footer {
    text-align: center;
    margin-top: 30px;
    font-size: 13px;
    color: #990000;
}
